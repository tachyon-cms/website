---
import { Font } from 'astro:assets';
import '../brand/tokens.css';
import AnnounceBar from '../components/AnnounceBar.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  /** The page's own path, such as "/roadmap", for its canonical URL. */
  path: string;
  /** A social card image, relative to the site. */
  image?: string;
  imageAlt?: string;
  /** A blog post's date, for the article meta tags. */
  published?: Date;
  /** Pages that only make sense mid-signup stay out of search results. */
  noindex?: boolean;
}
const {
  title,
  description = 'TachyonCMS is an open-source CMS written in Rust, built in public.',
  path,
  image,
  imageAlt,
  published,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- html.js: scripts will run. mark-pending holds the mark undrawn until its draw-in
         starts; if that script hasn't run in 1.5 s, the finished mark shows anyway.
         Hashed by scripts/csp.mjs. -->
    <script is:inline>
      document.documentElement.classList.add('js', 'mark-pending');
      setTimeout(() => document.documentElement.classList.remove('mark-pending'), 1500);
    </script>
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0d0d" />
    <Seo title={title} description={description} path={path} image={image} imageAlt={imageAlt} published={published} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="TachyonCMS blog" href="/rss.xml" />
    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: 400 }]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <AnnounceBar />
    <SiteHeader path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    background: var(--c-bg);
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--c-bg);
    color: var(--c-text);
    font: 400 1.0625rem/1.65 var(--font-sans);
    /* The home hero's backdrop is 100vw wide, which overshoots where a scrollbar
     * takes up room. Nothing else on the site should reach past the edge. */
    overflow-x: clip;
  }
  /* The same width and gutters as the header and footer. */
  main {
    flex: 1;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (max-width: 899.98px) {
    main {
      padding: 0 16px;
    }
  }
  a {
    color: var(--c-blue-soft);
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 2px solid var(--c-blue);
    outline-offset: 3px;
  }
  h1,
  h2,
  h3 {
    color: var(--c-text);
  }
  p {
    margin: 0 0 1.25rem;
  }
  .skip {
    position: absolute;
    left: 16px;
    top: -4rem;
    /* Above the sticky header (z-index 20). */
    z-index: 30;
    padding: 0.6rem 1rem;
    color: var(--c-on-blue);
    background: var(--c-blue);
    border-radius: 999px;
  }
  .skip:focus {
    top: 1rem;
  }
  /* Call-to-action links: .btn is the blue one, .btn.ghost the quiet one beside it.
   * The header's Get started is a .btn at a smaller size. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    font: 600 15px/1 var(--font-sans);
    white-space: nowrap;
    text-decoration: none;
    color: var(--c-on-blue);
    background: var(--c-blue);
    border: 1px solid transparent;
    border-radius: 9px;
  }
  .btn:hover {
    background: var(--c-blue-soft);
  }
  .btn.ghost {
    color: var(--c-text);
    background: transparent;
    border-color: var(--c-line-2);
  }
  .btn.ghost:hover {
    background: rgb(255 255 255 / 0.04);
    border-color: var(--c-dim);
  }
  @media (prefers-reduced-motion: no-preference) {
    .btn {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease;
    }
  }
  /* A status beside a title: "On the roadmap", "Under way", "Pre-release". */
  .pill {
    display: inline-block;
    padding: 4px 11px;
    font: 400 12px/1.4 var(--font-mono);
    letter-spacing: normal;
    color: var(--c-blue-soft);
    background: var(--c-blue-deep);
    border: 1px solid color-mix(in srgb, var(--c-blue) 35%, transparent);
    border-radius: 999px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0s !important;
      animation-delay: 0s !important;
      transition-duration: 0s !important;
      scroll-behavior: auto !important;
    }
  }
</style>
