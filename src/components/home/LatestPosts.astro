---
import SectionHead from './SectionHead.astro';

export interface PostLink {
  title: string;
  href: string;
  date: Date;
  summary: string;
}
interface Props {
  /** Published posts only, newest first. The section renders nothing while this is empty. */
  posts: PostLink[];
}
const posts = Astro.props.posts.slice(0, 3);
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

{
  posts.length > 0 && (
    <section id="latest" class="band" aria-labelledby="latest-title">
      <SectionHead id="latest-title" eyebrow="From the blog" title="What's new" />
      <ul>
        {posts.map((p) => (
          <li>
            <time datetime={p.date.toISOString().slice(0, 10)}>{day.format(p.date)}</time>
            <h3>
              <a href={p.href}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* A ruled list: the date in the margin, the post beside it. */
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }
  li {
    display: grid;
    gap: 6px;
    padding: 24px 0;
    border-bottom: 1px solid var(--c-line);
  }
  time {
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--c-muted);
  }
  h3 {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  h3 a {
    color: var(--c-text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--c-blue-soft);
  }
  p {
    max-width: 60ch;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
  @media (min-width: 48rem) {
    li {
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: 32px;
    }
    time {
      grid-row: span 2;
      padding-top: 4px;
    }
  }
</style>
