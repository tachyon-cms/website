---
interface Props {
  eyebrow: string;
  title: string;
  /** The h2's id, for the section's aria-labelledby. */
  id: string;
}
const { eyebrow, title, id } = Astro.props;
---

<header class="section-head">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <slot />
</header>

<style>
  .section-head {
    max-width: 44rem;
    margin-bottom: 48px;
  }
  .eyebrow {
    margin: 0 0 18px;
    font: 400 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--c-blue-soft);
  }
  h2 {
    max-width: 22ch;
    margin: 0 0 20px;
    font-size: clamp(2rem, 2.5vw + 1.1rem, 2.75rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .section-head > :global(p:not(.eyebrow)) {
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--c-muted);
  }
  .section-head > :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
