---
// The frame every diagram sits in, plus the styles its pieces share. The motion
// lives in src/scripts/play.ts; without it, the pieces below simply show.
interface Props {
  /** Names the diagram for tests and styling. */
  id: string;
  /** How long one loop runs, in milliseconds. */
  loop: number;
  caption: string;
}
const { id, loop, caption } = Astro.props;
---

<figure class="diagram" data-diagram={id} data-play={loop}>
  <slot />
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import { play } from '../../scripts/play';
  play();
</script>

<style is:global>
  .diagram {
    margin: 0;
  }
  .diagram figcaption {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .diagram .pane {
    min-width: 0;
    background: linear-gradient(var(--c-panel), var(--c-bg));
    border: 1px solid var(--c-line-2);
    border-radius: 14px;
    box-shadow: 0 30px 80px -30px #000;
  }
  .diagram .pane-head {
    margin: 0;
    padding: 10px 14px;
    font: 400 11.5px/1.4 var(--font-mono);
    color: var(--c-muted);
    border-bottom: 1px solid var(--c-line);
  }
  /* Wrapped rather than scrolled, so no line hides off the edge of a phone. */
  .diagram pre {
    margin: 0;
    --pad: 14px;
    padding: 14px var(--pad) 16px;
    font: 400 12px/1.7 var(--font-mono);
    color: #c9cbcf;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .diagram pre > span {
    display: block;
  }
  @media (min-width: 30rem) {
    .diagram pre {
      --pad: 16px;
      font-size: 12.5px;
    }
  }
  /* Code colours: keys, strings, quiet punctuation and prompts, a good outcome
   * in blue, a warning in amber. */
  .diagram .k {
    color: var(--c-blue-soft);
  }
  .diagram .s {
    color: var(--c-code-string);
  }
  .diagram .p,
  .diagram .q {
    color: var(--c-muted);
  }
  .diagram .ok {
    color: var(--c-blue);
  }
  .diagram .warn {
    color: var(--c-warn);
  }
  .diagram .warn :is(.k, .s, .p) {
    color: inherit;
  }
  .diagram .mark {
    margin-inline: calc(-1 * var(--pad));
    padding-inline: calc(var(--pad) - 2px) var(--pad);
    border-left: 2px solid var(--c-blue);
    background: color-mix(in srgb, var(--c-blue) 10%, transparent);
  }
  .diagram .arrow {
    display: grid;
    place-items: center;
    align-self: center;
    justify-self: center;
    width: 32px;
    height: 32px;
    color: var(--c-blue);
    background: var(--c-bg);
    border: 1px solid var(--c-line-2);
    border-radius: 50%;
  }

  /* The motion. play.ts adds .armed, then .on to each piece in turn. */
  .diagram [data-at] {
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .diagram.armed [data-at]:not(.on) {
    opacity: 0;
    transform: translateY(6px);
  }
  .diagram.rewind [data-at] {
    opacity: 0;
  }
  .diagram.armed .arrow.on {
    animation: diagram-pulse 0.9s ease-out;
  }
  .diagram.armed .mark.on {
    animation: diagram-glow 1.4s ease-out;
  }
  @keyframes diagram-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-blue) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 14px transparent;
    }
  }
  @keyframes diagram-glow {
    from {
      background: color-mix(in srgb, var(--c-blue) 35%, transparent);
    }
  }
</style>
