---
// The frame every diagram sits in, plus the styles its pieces share. The motion
// lives in src/scripts/play.ts; without it, the pieces below simply show.
interface Props {
  /** Names the diagram for tests and styling. */
  id: string;
  /** How long one loop runs, in milliseconds. */
  loop: number;
  caption: string;
}
const { id, loop, caption } = Astro.props;
---

<figure class="diagram" data-diagram={id} data-play={loop}>
  <slot />
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import { play } from '../../scripts/play';
  play();
</script>

<style is:global>
  .diagram {
    margin: 0;
  }
  .diagram figcaption {
    margin-top: 0.9rem;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .diagram .pane {
    min-width: 0;
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 14px;
    box-shadow: 0 24px 60px -36px color-mix(in srgb, var(--c-blue) 70%, transparent);
  }
  .diagram .pane-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.6rem 1rem;
    font: 600 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    border-bottom: 1px solid var(--c-line);
  }
  .diagram .pane-head::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-blue);
  }
  /* Wrapped rather than scrolled, so no line hides off the edge of a phone. */
  .diagram pre {
    margin: 0;
    --pad: 0.75rem;
    padding: 0.9rem var(--pad) 1rem;
    font: 400 0.75rem/1.65 var(--font-mono);
    color: var(--c-text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .diagram pre > span {
    display: block;
  }
  @media (min-width: 30rem) {
    .diagram pre {
      --pad: 1rem;
      font-size: 0.8125rem;
    }
  }
  /* Code colours: keys, quiet punctuation, a good outcome, a warning. */
  .diagram .k {
    color: var(--c-blue-soft);
  }
  .diagram .s {
    color: var(--c-code-string);
  }
  .diagram .p,
  .diagram .q {
    color: var(--c-muted);
  }
  .diagram .ok {
    color: var(--c-blue-soft);
  }
  .diagram .warn {
    color: var(--c-blue);
  }
  .diagram .mark {
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    box-shadow: inset 2px 0 0 var(--c-blue);
    background: color-mix(in srgb, var(--c-blue) 10%, transparent);
  }
  .diagram .arrow {
    display: grid;
    place-items: center;
    align-self: center;
    justify-self: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--c-on-blue);
    background: var(--c-blue);
    border-radius: 50%;
  }

  /* The motion. play.ts adds .armed, then .on to each piece in turn. */
  .diagram [data-at] {
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .diagram.armed [data-at]:not(.on) {
    opacity: 0;
    transform: translateY(6px);
  }
  .diagram.rewind [data-at] {
    opacity: 0;
  }
  .diagram.armed .arrow.on {
    animation: diagram-pulse 0.9s ease-out;
  }
  .diagram.armed .mark.on {
    animation: diagram-glow 1.4s ease-out;
  }
  @keyframes diagram-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-blue) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 14px transparent;
    }
  }
  @keyframes diagram-glow {
    from {
      background: color-mix(in srgb, var(--c-blue) 35%, transparent);
    }
  }
</style>
