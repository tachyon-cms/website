---
// A block of code for a diagram, one line per entry. A line with `at` is a piece
// the player reveals at that time. JSON keys, strings and punctuation and `$`
// prompts get coloured here, so the diagrams can be written as plain text.
export type Line = string | { text: string; at?: number; class?: string };

interface Props {
  lines: Line[];
}
const { lines } = Astro.props;

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Only lines that look like JSON (a quote, or a bracket first) get their strings and
// punctuation painted, so prose lines such as CLI output keep their commas plain.
const json = /^\s*[{}[\]]|"/;
function paint(text: string) {
  const html = escape(text);
  if (html.startsWith('$ ')) return `<span class="q">$</span> ${html.slice(2)}`;
  if (!json.test(text)) return html;
  return html.replace(/("(?:[^"\\]|\\.)*")(\s*:)?|([{}[\],:])/g, (_, str, colon, punct) => {
    if (punct) return `<span class="p">${punct}</span>`;
    if (colon) return `<span class="k">${str}</span><span class="p">${colon}</span>`;
    return `<span class="s">${str}</span>`;
  });
}
const rows = lines.map((l) => (typeof l === 'string' ? { text: l } : l));
---

<pre>{rows.map((r) => <span data-at={r.at} class={r.class} set:html={paint(r.text) || ' '} />)}</pre>
