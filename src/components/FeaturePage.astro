---
// A page built from one entry in the features collection: the hero, then whatever
// the page puts in its default slot (a diagram or a code sample), then the entry's
// copy, the docs it hands over to, and the v0.1.0 sources its facts came from.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import Prose from './Prose.astro';

interface Props {
  /** The entry's id, which is its file name in src/content/features. */
  id: string;
  /** The page's short name: the eyebrow, and the first half of the <title>. */
  name: string;
  path: string;
  /** Docs pages to hand over to, as [slug, label]. The slug follows docs.tachyoncms.com/. */
  docs?: [string, string][];
}
const { id, name, path, docs = [] } = Astro.props;
const entry = await getEntry('features', id);
if (!entry) throw new Error(`FeaturePage: no feature called ${id}`);
const { Content } = await render(entry);
const { title, summary, status, sources } = entry.data;

const repo = 'https://github.com/tachyon-cms/tachyoncms';
const sourceHref = (s: string) => (s.startsWith('https://') ? s : `${repo}/blob/v0.1.0/${s}`);
const sourceLabel = (s: string) => s.replace(/^https:\/\/(www\.)?/, '').replace('#', ' § ');

const product = [
  ['/product/content-modelling', 'Content modelling'],
  ['/product/querying', 'Querying'],
  ['/product/access-control', 'Access control'],
  ['/product/sign-in', 'Sign-in'],
  ['/product/schema-as-code', 'Schema as code'],
  ['/product/admin', 'The admin'],
  ['/security', 'Security'],
];
const inProduct = product.some(([href]) => href === path);
---

<Base title={`${name} · TachyonCMS`} description={summary} path={path}>
  {
    inProduct && (
      <nav class="product-nav" aria-label="Product">
        {product.map(([href, label]) => (
          <a href={href} aria-current={href === path ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
    )
  }
  <PageHero eyebrow={name} title={title} lede={summary}>
    {status === 'headed' && <p class="roadmap">On the roadmap</p>}
  </PageHero>

  {Astro.slots.has('default') && <div class="sample"><slot /></div>}
  <div class="body">
    <Prose><Content /></Prose>
    <slot name="after" />
  </div>
  <div class="refs">
    {
      docs.length > 0 && (
        <section class="docs" aria-labelledby="docs-title">
          <h2 id="docs-title">In the docs</h2>
          <ul>
            {docs.map(([slug, label]) => (
              <li>
                <a href={`https://docs.tachyoncms.com/${slug}`}>
                  {label} <Icon name="FiArrowRight" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">{status === 'today' ? 'Checked against v0.1.0' : 'Where this comes from'}</h2>
      <p>
        Every claim on this page comes from one of these. If one's out of date,{' '}
        <a href="https://github.com/tachyon-cms/tachyoncms/issues">tell me in an issue</a>.
      </p>
      <ul>
        {
          sources.map((s) => (
            <li>
              <a href={sourceHref(s)}>{sourceLabel(s)}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  // On a phone the tab row scrolls; bring the current page's tab into view.
  const nav = document.querySelector<HTMLElement>('.product-nav');
  const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (nav && current && nav.scrollWidth > nav.clientWidth) {
    nav.scrollLeft = current.offsetLeft - nav.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2;
  }
</script>

<style>
  /* A row of tabs under the site header, its line running the full width. */
  .product-nav {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    /* The border is drawn out past the box to both screen edges; a pseudo-element
     * would be clipped by the scrolling. */
    border-bottom: 1px solid;
    border-image: linear-gradient(var(--c-line), var(--c-line)) 0 0 1 0 / 0 0 1px 0 / 0 100vw;
  }
  /* On a phone the row scrolls, running off the right edge to show there's more. */
  @media (max-width: 899.98px) {
    .product-nav {
      margin-right: -16px;
      padding-right: 16px;
    }
  }
  .product-nav a {
    position: relative;
    z-index: 1;
    flex: none;
    padding: 14px 0 13px;
    font-size: 14px;
    color: var(--c-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .product-nav a:hover {
    color: var(--c-text);
  }
  .product-nav a[aria-current='page'] {
    color: var(--c-text);
    border-bottom-color: var(--c-blue);
  }
  .roadmap {
    display: inline-block;
    margin: 28px 0 0;
    padding: 4px 11px;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--c-blue-soft);
    background: var(--c-blue-deep);
    border: 1px solid color-mix(in srgb, var(--c-blue) 35%, transparent);
    border-radius: 999px;
  }
  .sample {
    display: grid;
    gap: 48px;
    padding-top: 64px;
  }
  .body {
    display: grid;
    gap: 48px;
    padding: 72px 0 24px;
  }
  /* Wide, each h2 takes the left column beside its first paragraph, and the
   * text reads down the right at a comfortable measure. */
  @media (min-width: 64rem) {
    .body :global(.prose) {
      display: grid;
      grid-template-columns: minmax(0, 17rem) minmax(0, 42rem);
      column-gap: 4rem;
      max-width: none;
    }
    .body :global(.prose > *) {
      grid-column: 2;
    }
    .body :global(.prose > h2) {
      grid-column: 1;
      font-size: 1.375rem;
    }
    .body :global(.prose > h3) {
      margin-top: 2rem;
      font-size: 1.0625rem;
      letter-spacing: -0.01em;
    }
    .body :global(.prose > :is(h2, h2 + *)) {
      margin-top: 0;
      padding-top: 2rem;
      border-top: 1px solid var(--c-line);
    }
    .body :global(.prose > :is(h2, h2 + *):not(:first-child, h2:first-child + *)) {
      margin-top: 2.5rem;
    }
    /* The hero's line already sits above the first one. */
    .body :global(.prose > :is(h2:first-child, h2:first-child + *)) {
      padding-top: 0;
      border-top: 0;
    }
    .body > :global(:not(.prose)) {
      margin-left: calc(17rem + 4rem);
      max-width: 42rem;
    }
  }
  .body > :global(:not(.prose)) {
    width: 100%;
  }
  .refs {
    display: grid;
    gap: 40px;
    margin-top: 48px;
    padding: 48px 0 clamp(3.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--c-line);
  }
  @media (min-width: 56rem) {
    .refs:has(> .docs) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 0;
    }
    .refs > section + section {
      padding-left: 40px;
      border-left: 1px solid var(--c-line);
    }
    .refs > section:first-child:not(:only-child) {
      padding-right: 40px;
    }
  }
  .refs h2 {
    margin: 0 0 16px;
    font: 400 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--c-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs li + li {
    border-top: 1px solid var(--c-line);
  }
  .docs a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    font-weight: 500;
    color: var(--c-text);
    text-decoration: none;
  }
  .docs a :global(svg) {
    color: var(--c-blue);
  }
  .docs a:hover {
    color: var(--c-blue-soft);
  }
  .sources p {
    max-width: 52ch;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
  .sources ul {
    max-width: 48rem;
    columns: 2 18rem;
    column-gap: 32px;
  }
  .sources li {
    padding: 3px 0;
    font: 400 12.5px/1.5 var(--font-mono);
    overflow-wrap: anywhere;
    break-inside: avoid;
  }
  .sources a {
    color: var(--c-muted);
    text-decoration: none;
  }
  .sources a:hover {
    color: var(--c-blue-soft);
  }
  .sources p a {
    color: var(--c-blue-soft);
    text-decoration: underline;
  }
</style>
