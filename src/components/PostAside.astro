---
// Beside a post: its sections, then ways to pass it on.
import Icon from './Icon.astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  url: string;
  title: string;
}
const { headings, url, title } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
const u = encodeURIComponent(url);
const shares = [
  { name: 'X', icon: 'SiX', href: `https://x.com/intent/post?url=${u}&text=${encodeURIComponent(title)}` },
  { name: 'LinkedIn', icon: 'FiLinkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
];
---

<aside class="post-aside" aria-label="About this post">
  {
    sections.length > 1 && (
      <nav aria-labelledby="sections-title">
        <p class="label" id="sections-title">In this post</p>
        <ol>
          {sections.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <div>
    <p class="label">Share</p>
    <ul class="share">
      {
        shares.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              <Icon name={s.icon} />
              <span class="sr-only">Share on {s.name}</span>
            </a>
          </li>
        ))
      }
      <li hidden>
        <button type="button" data-copy={url}>
          <Icon name="FiLink" />
          <span class="sr-only">Copy link</span>
        </button>
      </li>
    </ul>
    <p class="copied" role="status" data-copied></p>
  </div>
</aside>

<script>
  // Copying needs the clipboard API, so the button only shows when there's JS to run it.
  const status = document.querySelector<HTMLElement>('[data-copied]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.parentElement!.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        if (status) status.textContent = 'Link copied';
      } catch {
        if (status) status.textContent = "Couldn't copy. The link is in the address bar.";
      }
    });
  }
</script>

<style>
  .post-aside {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .label {
    margin: 0 0 14px;
    font: 400 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--c-muted);
  }
  ol {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0 0.9rem;
    list-style: none;
    border-left: 1px solid var(--c-line);
  }
  ol a {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--c-muted);
    text-decoration: none;
  }
  ol a:hover {
    color: var(--c-blue-soft);
  }
  .share {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .share :is(a, button) {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--c-text);
    background: transparent;
    border: 1px solid var(--c-line-2);
    border-radius: 9px;
    cursor: pointer;
  }
  .share :is(a, button):hover {
    border-color: var(--c-blue-soft);
  }
  .copied {
    min-height: 1.5em;
    margin: 0.6rem 0 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
</style>
