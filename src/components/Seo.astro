---
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  /** A blog post's date: the page becomes an og:type article with its published time. */
  published?: Date;
  noindex?: boolean;
}
// A page without a card of its own unfurls with the brand's social preview.
const brandCard = {
  image: '/brand/social-preview.png',
  width: 1280,
  height: 640,
  alt: 'TachyonCMS: Content at the speed of your code. An open-source headless CMS, one Rust binary, one Postgres database.',
};
const { title, description, path, image, imageAlt, published, noindex = false } = Astro.props;
const card: { image: string; alt?: string; width?: number; height?: number } = image ? { image, alt: imageAlt } : brandCard;
const canonical = new URL(path, Astro.site);
const imageUrl = new URL(card.image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:site_name" content="TachyonCMS" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={published ? 'article' : 'website'} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{card.width && <meta property="og:image:width" content={String(card.width)} />}
{card.height && <meta property="og:image:height" content={String(card.height)} />}
{card.alt && <meta property="og:image:alt" content={card.alt} />}
<meta name="twitter:card" content="summary_large_image" />
