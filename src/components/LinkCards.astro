---
// A row of links that each need a sentence of context, such as the polls on /roadmap.
import Icon from './Icon.astro';

interface Props {
  links: { href: string; title: string; text: string }[];
}
const { links } = Astro.props;
---

<ul class="link-cards">
  {
    links.map(({ href, title, text }) => (
      <li>
        <a href={href}>
          <strong>{title}</strong>
          <span>{text}</span>
          <Icon name="FiArrowRight" size={16} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .link-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem;
    color: var(--c-muted);
    text-decoration: none;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 14px;
  }
  a:hover {
    border-color: var(--c-soft);
  }
  strong {
    color: var(--c-text);
  }
  a :global(svg) {
    color: var(--c-soft);
  }
</style>
