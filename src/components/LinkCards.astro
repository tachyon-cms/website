---
// A row of links that each need a sentence of context, such as the polls on /roadmap.
import Icon from './Icon.astro';

interface Props {
  links: { href: string; title: string; text: string }[];
}
const { links } = Astro.props;
---

<ul class="link-cards">
  {
    links.map(({ href, title, text }) => (
      <li>
        <a href={href}>
          <strong>{title}</strong>
          <span>{text}</span>
          <Icon name="FiArrowRight" size={16} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Rows split by hairlines: the link and its sentence on the left, an arrow on the
   * right. No outer rules, so it never doubles a section's own. */
  .link-cards {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  li + li {
    border-top: 1px solid var(--c-line);
  }
  li:first-child a {
    padding-top: 0;
  }
  li:last-child a {
    padding-bottom: 0;
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 16px;
    padding: 16px 0;
    color: var(--c-muted);
    text-decoration: none;
  }
  strong {
    font-weight: 600;
    color: var(--c-text);
  }
  span {
    grid-column: 1;
    font-size: 0.9375rem;
  }
  a :global(svg) {
    grid-area: 1 / 2 / 3;
    color: var(--c-blue);
  }
  a:hover strong {
    color: var(--c-blue-soft);
  }
</style>
