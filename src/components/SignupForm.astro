---
// The markup public/signup.js drives: form.signup holding a .cf-turnstile slot with
// the site key. The script loads Turnstile only once someone starts on the form.
interface Props {
  /** What the form is for, which sets its label. Every form joins the same list. */
  source: 'news' | 'editors';
}
const { source } = Astro.props;
const id = `signup-email-${source}`;
// The label fits where the form sits. There's one list behind every form, so the
// promise in the fine print is the same everywhere, and matches server/signup.ts.
const label = { news: 'Get release news', editors: 'Tell me when the admin is ready' }[source];
// One script tag per page, however many forms: it binds every form.signup.
const firstForm = !Astro.locals.signupScript;
Astro.locals.signupScript = true;

// Public by design: the site key only identifies the widget. Cloudflare's always-pass test
// key stands in locally; a production build without the real one fails rather than ship it.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? (import.meta.env.CF_PAGES ? undefined : '1x00000000000000000000AA');
if (!siteKey) throw new Error('PUBLIC_TURNSTILE_SITE_KEY must be set for a Cloudflare Pages build');
---

<form class="signup" method="post" action="/api/subscribe">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
    <button type="submit">Notify me</button>
  </div>
  <div class="trap" aria-hidden="true">
    <label for={`${id}-trap`}>Leave this empty</label>
    <input id={`${id}-trap`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="cf-turnstile" data-sitekey={siteKey}></div>
  <p class="fine">We'll send one email to confirm your address, then write only when there's a release or news of the admin. Unsubscribe any time.</p>
</form>
{firstForm && <script is:inline src="/signup.js" defer />}

<style>
  .signup {
    max-width: 36rem;
    padding: 24px;
    background: linear-gradient(var(--c-panel), var(--c-bg));
    border: 1px solid var(--c-line-2);
    border-radius: 14px;
  }
  label {
    display: block;
    margin-bottom: 14px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    font: inherit;
    font-size: 15px;
    color: var(--c-text);
    background: var(--c-bg);
    border: 1px solid var(--c-line-2);
    border-radius: 9px;
  }
  input[type='email']::placeholder {
    color: var(--c-muted);
  }
  input[type='email']:focus-visible {
    border-color: var(--c-blue);
    outline-offset: 1px;
  }
  /* The site's primary button, as a real button. */
  button {
    height: 44px;
    padding: 0 20px;
    font: 600 15px/1 var(--font-sans);
    color: var(--c-on-blue);
    background: var(--c-blue);
    border: 0;
    border-radius: 9px;
    cursor: pointer;
  }
  button:hover {
    background: var(--c-blue-soft);
  }
  .fine {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .cf-turnstile:not(:empty) {
    margin-top: 0.9rem;
  }
  /* Hidden from people, still in the form for bots that fill every field. */
  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
