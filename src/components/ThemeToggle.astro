---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
  <Icon name="FiSun" class="sun" />
  <Icon name="FiMoon" class="moon" />
  <span>Light theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: 0.875rem;
    color: var(--c-text);
    background: transparent;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--c-soft);
  }
  /* No JS, no theme script: the button couldn't work, so it isn't shown. */
  :global(html:not([data-theme])) .theme-toggle {
    display: none;
  }
  .theme-toggle :global(.moon),
  :global([data-theme='light']) .theme-toggle :global(.sun) {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle :global(.moon) {
    display: inline;
  }
</style>
