---
import Mark from './Mark.astro';

const groups = [
  {
    title: 'Product',
    links: [
      ['/why', 'Why TachyonCMS'],
      ['/editors', 'For editors'],
      ['/product/content-modelling', 'Content modelling'],
      ['/product/querying', 'Querying'],
      ['/product/access-control', 'Access control'],
      ['/product/sign-in', 'Sign-in'],
      ['/product/schema-as-code', 'Schema as code'],
      ['/product/admin', 'Admin (planned)'],
      ['/security', 'Security'],
      ['/compare', 'Compare'],
    ],
  },
  {
    title: 'Project',
    links: [
      ['/roadmap', 'Roadmap'],
      ['/releases', 'Releases'],
      ['/blog', 'Blog'],
      ['/community', 'Community'],
      ['/starters', 'Starters (planned)'],
      ['/faq', 'FAQ'],
      ['https://docs.tachyoncms.com', 'Docs'],
      ['https://github.com/tachyon-cms/tachyoncms', 'GitHub'],
    ],
  },
  {
    title: 'About',
    links: [
      ['/brand', 'Brand'],
      ['/privacy', 'Privacy'],
      ['/trademark', 'Trademark'],
    ],
  },
  {
    title: 'Contact',
    links: [
      ['mailto:hello@tachyoncms.com', 'hello@tachyoncms.com'],
      ['mailto:security@tachyoncms.com', 'security@tachyoncms.com'],
      ['mailto:conduct@tachyoncms.com', 'conduct@tachyoncms.com'],
      ['mailto:legal@tachyoncms.com', 'legal@tachyoncms.com'],
      ['mailto:sponsors@tachyoncms.com', 'sponsors@tachyoncms.com'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="top">
      <a class="logo" href="/">
        <Mark size={22} animate={false} />
        TachyonCMS
      </a>
      <nav aria-label="Site map">
        {
          groups.map(({ title, links }) => (
            <div>
              <h2>{title}</h2>
              <ul>
                {links.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="base">
      <p>MIT licensed and built in public.</p>
      <p>© 2026 TachyonCMS</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--c-line);
    font-size: 14px;
  }
  .inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 24px 32px;
  }
  .top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .logo {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 9px;
    width: max-content;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }
  nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 32px 24px;
  }
  h2 {
    margin: 0 0 14px;
    /* 400 is the preloaded mono weight, so a first visit never shows the fallback. */
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    margin-top: 9px;
  }
  a {
    color: var(--c-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a:hover {
    color: var(--c-text);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--c-line);
    font: 12.5px var(--font-mono);
    color: var(--c-muted);
  }
  .base p {
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    a {
      transition: color 0.15s ease;
    }
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: 14rem 1fr;
    }
  }
  @media (max-width: 899.98px) {
    .inner {
      padding-inline: 16px;
    }
    nav {
      grid-template-columns: 1fr 1fr;
    }
    /* The addresses are too long for half a phone, so they get the full width. */
    nav > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>
