---
// Long-form text: policies, posts, release notes. Styles the plain elements Markdown emits.
interface Props {
  /** Wide screens put each h2 in a left column beside its text. */
  split?: boolean;
}
const { split } = Astro.props;
---

<div class:list={['prose', { split }]}><slot /></div>

<style>
  /* A flag or a path in inline code can be longer than a phone is wide. */
  .prose {
    max-width: 42rem;
    color: var(--c-muted);
    overflow-wrap: break-word;
  }
  .prose :global(:where(h2, h3)) {
    color: var(--c-text);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h2) {
    font-size: 1.625rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
  }
  .prose :global(:where(p, ul, ol, blockquote, pre)) {
    margin: 0 0 1.25rem;
  }
  /* 600, the preloaded bold, not the browser's 700. */
  .prose :global(:where(strong, b, th)) {
    font-weight: 600;
  }
  .prose :global(strong) {
    color: var(--c-text);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    font: 400 0.875em var(--font-mono);
    color: var(--c-text);
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 5px;
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    overflow-x: auto;
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 10px;
  }
  .prose :global(pre code) {
    padding: 0;
    color: var(--c-text);
    background: none;
    border: 0;
  }
  .prose :global(table) {
    width: 100%;
    margin: 0 0 1.25rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose :global(:where(th, td)) {
    padding: 0.6rem 0.75rem 0.6rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }
  .prose :global(th) {
    color: var(--c-text);
  }
  .prose :global(td:first-child) {
    color: var(--c-text);
    white-space: nowrap;
  }
  .prose :global(blockquote) {
    padding-left: 1rem;
    border-left: 2px solid var(--c-blue);
  }
  /* Wide, each h2 takes the left column beside its first paragraph, and the text
   * reads down the right at a comfortable measure, with a rule over each pair. */
  @media (min-width: 64rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 17rem) minmax(0, 42rem);
      column-gap: 4rem;
      max-width: none;
    }
    .split > :global(*) {
      grid-column: 2;
    }
    .split > :global(h2) {
      grid-column: 1;
      font-size: 1.375rem;
    }
    .split > :global(h3) {
      margin-top: 2rem;
      font-size: 1.0625rem;
      letter-spacing: -0.01em;
    }
    .split > :global(:is(h2, h2 + *)) {
      margin-top: 0;
      padding-top: 2rem;
      border-top: 1px solid var(--c-line);
    }
    .split > :global(:is(h2, h2 + *):not(:first-child, h2:first-child + *)) {
      margin-top: 2.5rem;
    }
    /* The hero's line already sits above the first one. */
    .split > :global(:is(h2:first-child, h2:first-child + *)) {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
