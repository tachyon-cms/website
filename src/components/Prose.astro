---
// Long-form text: policies, posts, release notes. Styles the plain elements Markdown emits.
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: 42rem;
    color: var(--c-muted);
  }
  .prose :global(:where(h2, h3)) {
    color: var(--c-text);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h2) {
    font-size: 1.625rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
  }
  .prose :global(:where(p, ul, ol, blockquote, pre)) {
    margin: 0 0 1.25rem;
  }
  .prose :global(strong) {
    color: var(--c-text);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    font: 400 0.875em var(--font-mono);
    color: var(--c-text);
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 5px;
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    overflow-x: auto;
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 10px;
  }
  .prose :global(pre code) {
    padding: 0;
    color: var(--c-text);
    background: none;
    border: 0;
  }
  .prose :global(table) {
    width: 100%;
    margin: 0 0 1.25rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose :global(:where(th, td)) {
    padding: 0.6rem 0.75rem 0.6rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }
  .prose :global(th) {
    color: var(--c-text);
  }
  .prose :global(td:first-child) {
    color: var(--c-text);
    white-space: nowrap;
  }
  .prose :global(blockquote) {
    padding-left: 1rem;
    border-left: 2px solid var(--c-blue);
  }
</style>
