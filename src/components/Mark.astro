---
// The slipstream mark, inline so it can draw itself in: the strokes trace in, the
// point lands, then glows. The geometry matches brand/build.mjs.
//
// Without the .draw class the mark is simply drawn, which is what no-JS and reduced
// motion get. The script adds .draw on load and again when the pointer enters the
// parent .brand, which replays it.
interface Props {
  size?: number;
  animate?: boolean;
}
const { size = 26, animate = true } = Astro.props;
---

<svg class="mark" data-animate={animate ? '' : undefined} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <path class="stroke" pathLength="1" opacity="0.35" d="M10 50 L22 14"></path>
  <path class="stroke" pathLength="1" opacity="0.65" d="M24 50 L36 14"></path>
  <path class="stroke" pathLength="1" d="M38 50 L50 14"></path>
  <circle class="point" cx="54" cy="50" r="5"></circle>
</svg>

<script>
  for (const mark of document.querySelectorAll<SVGElement>('.mark[data-animate]')) {
    const draw = () => {
      mark.classList.remove('draw');
      // Forces a style recalc, so the animation starts over.
      void mark.getBoundingClientRect();
      mark.classList.add('draw');
    };
    draw();
    mark.closest('.brand')?.addEventListener('pointerenter', draw);
  }
</script>

<style>
  .mark {
    display: block;
    flex: none;
  }
  /* A dash of 1 then a gap of 2 on a path of length 1: at offset 0 the whole stroke
   * shows, and pushed past 1 the round cap can't peek out before it starts. */
  .stroke {
    fill: none;
    stroke: var(--c-blue);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
  }
  .point {
    fill: var(--c-blue-soft);
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .draw .stroke {
      animation: mark-draw 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .draw .stroke:nth-child(2) {
      animation-delay: 80ms;
    }
    .draw .stroke:nth-child(3) {
      animation-delay: 160ms;
    }
    .draw .point {
      animation:
        mark-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 420ms both,
        mark-glow 1.2s ease-out 750ms;
    }
  }
  @keyframes mark-draw {
    from {
      stroke-dashoffset: 1.05;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mark-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes mark-glow {
    35% {
      filter: drop-shadow(0 0 8px var(--c-blue));
    }
  }
</style>
