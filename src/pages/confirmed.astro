---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
---

<Base title="You're on the list · TachyonCMS" path="/confirmed" noindex>
  <PageHero title="You're on the list">
    <p class="notice">We'll email you the day TachyonCMS launches. Until then, you can <a href="https://github.com/tachyon-cms/tachyoncms">watch it being built on GitHub</a>.</p>
  </PageHero>
</Base>

<style>
  .notice {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--c-muted);
  }
</style>
