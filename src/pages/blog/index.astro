---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { postDate, publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();
---

<Base
  title="Blog · TachyonCMS"
  description="Releases, plans and notes from building TachyonCMS in public."
  path="/blog"
>
  <PageHero
    eyebrow="Blog"
    title="Notes from the build"
    lede="What shipped, what's next, and why it's in that order. Written as it happens, with nothing promised before it's real."
  >
    <p class="feed">
      <a href="/rss.xml"><Icon name="FiRss" size={16} /> Follow along by RSS</a>
    </p>
  </PageHero>

  <ol class="posts">
    {
      posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{postDate.format(p.data.date)}</time>
          <h2>
            <a href={`/blog/${p.id}`}>{p.data.title}</a>
          </h2>
          <p>{p.data.description}</p>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .feed {
    margin: 28px 0 0;
    font-size: 15px;
  }
  .feed a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .posts {
    margin: 0;
    padding: 64px 0 clamp(3.5rem, 6vw, 4.5rem);
    list-style: none;
  }
  .posts li {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 32px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .posts li:first-child {
    padding-top: 0;
  }
  time {
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--c-muted);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h2 a {
    color: var(--c-text);
    text-decoration: none;
  }
  /* The whole entry is the link's target, while the h2 stays the accessible name. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  li:hover h2 a {
    color: var(--c-blue-soft);
  }
  .posts p {
    max-width: 60ch;
    margin: 0;
    color: var(--c-muted);
  }
  @media (min-width: 48rem) {
    .posts li {
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: 32px;
    }
    time {
      grid-row: span 2;
      padding-top: 6px;
    }
  }
</style>
