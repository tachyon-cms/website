---
import { render } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import PostAside from '../../components/PostAside.astro';
import Prose from '../../components/Prose.astro';
import Base from '../../layouts/Base.astro';
import { postDate, publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const path = `/blog/${post.id}`;
const words = (post.body ?? '').replace(/```[\s\S]*?```|<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<Base
  title={`${post.data.title} · TachyonCMS`}
  description={post.data.description}
  path={path}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  published={post.data.date}
>
  <article>
    <PageHero title={post.data.title} lede={post.data.description}>
      <a slot="eyebrow" href="/blog">Blog</a>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{postDate.format(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        {post.data.author}
        <span aria-hidden="true">·</span>
        {minutes} min read
      </p>
    </PageHero>
    <div class="layout">
      <Prose><Content /></Prose>
      <PostAside headings={headings} url={new URL(path, Astro.site).href} title={post.data.title} />
    </div>
  </article>
</Base>

<style>
  article {
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 24px 0 0;
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--c-muted);
  }
  .layout {
    display: grid;
    gap: 3rem;
    padding-top: 64px;
  }
  .layout > :global(.prose) {
    min-width: 0;
  }
  /* The first paragraph reads a size up, in full colour. */
  .layout :global(.prose > p:first-child) {
    font-size: 1.1875rem;
    color: var(--c-text);
  }
  .layout :global(.prose figure) {
    margin: 2rem 0;
  }
  .layout :global(.prose figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-line);
    border-radius: 12px;
  }
  .layout :global(.prose figcaption) {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
  /* Narrow screens: the contents list would come after the post it lists, so only sharing shows. */
  @media (max-width: 63.99rem) {
    .layout > :global(.post-aside) {
      padding-top: 2rem;
      border-top: 1px solid var(--c-line);
    }
    .layout :global(.post-aside nav) {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 42rem) 15rem;
      justify-content: space-between;
    }
    .layout > :global(.post-aside) {
      position: sticky;
      /* Clears the sticky site header. */
      top: 96px;
      align-self: start;
    }
  }
</style>
