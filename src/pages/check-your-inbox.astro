---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Check your inbox · TachyonCMS" path="/check-your-inbox" noindex>
  <PageHero title="Check your inbox">
    <p class="notice">We've sent a link to confirm your address. It works for 48 hours. Nothing there? Look in spam, or <a href="/">try again</a>.</p>
  </PageHero>
</Base>

<style>
  .notice {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--c-muted);
  }
</style>
