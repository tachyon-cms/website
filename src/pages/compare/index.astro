---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';

const order = ['wordpress', 'strapi', 'contentful', 'sanity', 'directus'];
const entries = (await getCollection('compare')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Base
  title="Compare · TachyonCMS"
  description="TachyonCMS side by side with WordPress, Strapi, Contentful, Sanity and Directus, with a source for every claim and a straight answer on who should pick which."
  path="/compare"
>
  <PageHero
    eyebrow="Compare"
    title="How TachyonCMS stacks up, honestly"
    lede="You're probably weighing TachyonCMS against something you already know. Each page below puts v0.1.0 beside it, row by row, with a link for every claim about the other product. And each one ends by saying who should pick which, even when the answer isn't us."
  />

  <ul class="list">
    {
      entries.map(({ id, data }) => (
        <li>
          <a href={`/compare/${id}`}>
            <h2>
              TachyonCMS and {data.name} <Icon name="FiArrowRight" size={18} />
            </h2>
            <p>{data.summary}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="note">
    The short version: TachyonCMS is pre-alpha, and there's no admin screen yet. If someone who doesn't write code needs
    to publish next week, every product here will serve them better today. The pages say exactly where.
  </p>
</Base>

<style>
  .list {
    margin: 0;
    padding: 64px 0 0;
    list-style: none;
  }
  .list a {
    display: grid;
    align-items: start;
    gap: 8px;
    padding: 28px 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--c-line);
  }
  .list li:first-child a {
    padding-top: 0;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  h2 :global(svg) {
    flex: none;
    color: var(--c-blue);
  }
  .list a:hover h2 {
    color: var(--c-blue-soft);
  }
  .list p {
    max-width: 60ch;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
  @media (min-width: 56rem) {
    .list a {
      grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
      column-gap: 4rem;
    }
  }
  .note {
    max-width: 60ch;
    margin: 48px 0 clamp(3.5rem, 6vw, 4.5rem);
    color: var(--c-muted);
  }
</style>
