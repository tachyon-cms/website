---
// One comparison: the table, where TachyonCMS isn't there yet, then who should pick which.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths() {
  const entries = await getCollection('compare');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'compare'> };
const { name, summary, checked, rows, notYet } = entry.data;
const { Content } = await render(entry);
const path = `/compare/${entry.id}`;
const readme = 'https://github.com/tachyon-cms/tachyoncms/blob/v0.1.0/README.md';
const day = checked.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// Cells are plain strings; `backticks` mark code, as in Markdown.
const escape = (text: string) => text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
const withCode = (text: string) =>
  text
    .split('`')
    .map((part, i) => (i % 2 ? `<code>${escape(part)}</code>` : escape(part)))
    .join('');
---

<Base title={`TachyonCMS and ${name} compared · TachyonCMS`} description={summary} path={path}>
  <PageHero eyebrow="Compare" title={`TachyonCMS and ${name}`} lede={summary} />

  <div class="compare">
    <p class="checked">
      Checked on <time datetime={checked.toISOString().slice(0, 10)}>{day}</time> against TachyonCMS v0.1.0 and {name}'s
      own docs. Each {name} row links to the page it came from.
    </p>

    <table>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Topic</span></th>
          <th scope="col">TachyonCMS v0.1.0</th>
          <th scope="col">{name}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.topic}</th>
              <td data-label="TachyonCMS v0.1.0">
                <Fragment set:html={withCode(row.tachyon)} />
              </td>
              <td data-label={name}>
                <Fragment set:html={withCode(row.them)} />{' '}
                <a class="src" href={row.source}>
                  Source<span class="sr-only">: {name}, {row.topic.toLowerCase()}</span>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <Prose split>
      <h2>Where TachyonCMS isn't there yet</h2>
      <ul>
        {notYet.map((item) => <li><Fragment set:html={withCode(item)} /></li>)}
      </ul>
      <Content />
    </Prose>

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Where this comes from</h2>
      <p>
        The TachyonCMS side comes from the <a href={readme}>v0.1.0 README</a> and its code. If a row's out of date,{' '}
        <a href="https://github.com/tachyon-cms/tachyoncms/issues">tell me in an issue</a> and I'll fix it.
      </p>
      <p><a href="/compare">All comparisons</a></p>
    </section>
  </div>
</Base>

<style>
  .compare {
    padding-top: 56px;
  }
  .checked {
    max-width: 60ch;
    margin: 0 0 32px;
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--c-muted);
  }
  table {
    width: 100%;
    margin: 0 0 72px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    padding: 16px 24px 16px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }
  thead th {
    padding-top: 0;
    font: 400 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--c-muted);
    border-bottom-color: var(--c-line-2);
  }
  tbody th {
    width: 13rem;
    font-weight: 600;
    color: var(--c-text);
  }
  td {
    color: var(--c-muted);
  }
  td:nth-child(2) {
    color: var(--c-text);
  }
  /* A chip in the text's own colour, as in the prose. */
  code {
    padding: 0.1em 0.35em;
    font: 400 0.875em var(--font-mono);
    color: var(--c-text);
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    border-radius: 5px;
  }
  .src {
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  /* On a phone each row becomes a block, with the product named above each cell. */
  @media (max-width: 40rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tr,
    th,
    td {
      display: block;
    }
    tr {
      padding: 20px 0;
      border-bottom: 1px solid var(--c-line);
    }
    tr:first-child {
      padding-top: 0;
    }
    tbody th,
    td {
      width: auto;
      padding: 0;
      border: 0;
    }
    tbody th {
      font-size: 1.0625rem;
    }
    td::before {
      content: attr(data-label);
      display: block;
      margin: 12px 0 2px;
      font: 400 12.5px/1.4 var(--font-mono);
      letter-spacing: 0.02em;
      color: var(--c-muted);
    }
  }
  /* The same close as a product page's: a mono label over a short note. */
  .sources {
    margin-top: 48px;
    padding: 48px 0 clamp(3.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--c-line);
  }
  .sources h2 {
    margin: 0 0 16px;
    font: 400 12.5px/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--c-muted);
  }
  .sources p {
    max-width: 60ch;
    margin: 0 0 12px;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
</style>
