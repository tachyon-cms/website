---
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import SignupForm from '../components/SignupForm.astro';
import Base from '../layouts/Base.astro';
import { releases as allReleases, renderNotes } from '../lib/github';

const releases = await allReleases();
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Releases · TachyonCMS"
  description="Every TachyonCMS release, with its notes, straight from GitHub."
  path="/releases"
>
  <PageHero
    eyebrow="Releases"
    title="Releases"
    lede="Every release, with its notes as they were published on GitHub. Want the next one in your inbox? Leave your address, or watch the repo on GitHub and choose Custom, then Releases."
  >
    <SignupForm source="news" />
  </PageHero>

  <div class="releases">
    {
      releases.map((r) => (
        <article aria-labelledby={`r-${r.tag}`}>
          <header>
            <h2 id={`r-${r.tag}`}>{r.name}</h2>
            <p class="meta">
              <time datetime={r.published.slice(0, 10)}>{day.format(new Date(r.published))}</time>
              {r.prerelease && <span class="pill">Pre-release</span>}
              <a href={r.url}>Downloads on GitHub</a>
            </p>
          </header>
          <Prose>
            <Fragment set:html={renderNotes(r.body, `${r.tag}-`)} />
            <p>
              <a href={r.url}>Downloads on GitHub</a>
            </p>
          </Prose>
        </article>
      ))
    }
  </div>
</Base>

<style>
  :global(.page-hero form.signup) {
    margin-top: 28px;
  }
  .releases {
    display: grid;
    padding: 64px 0 clamp(3.5rem, 6vw, 4.5rem);
  }
  /* min-width: 0 lets a long line of code scroll inside its block instead of
   * widening the page. */
  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  article + article {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 1px solid var(--c-line);
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0 0 32px;
    font-size: 15px;
    color: var(--c-muted);
  }
  time {
    font: 400 12.5px/1.6 var(--font-mono);
  }
  /* Wide, the version and its links hold the left column while the notes read down
   * the right, as the other long pages do. */
  @media (min-width: 64rem) {
    article {
      grid-template-columns: minmax(0, 17rem) minmax(0, 42rem);
      column-gap: 4rem;
    }
    header {
      position: sticky;
      top: 96px;
      align-self: start;
    }
    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
