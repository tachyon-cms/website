---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
---

<Base title="That didn't go through · TachyonCMS" path="/signup-problem" noindex>
  <PageHero title="That didn't go through">
    <p class="notice">Check the address and <a href="/">try again</a>. If it keeps happening, <a href="https://github.com/tachyon-cms/tachyoncms/issues">tell us on GitHub</a>.</p>
  </PageHero>
</Base>
