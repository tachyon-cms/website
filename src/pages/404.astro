---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Nothing here · TachyonCMS" path="/404" noindex>
  <PageHero title="Nothing here">
    <p class="notice">That page doesn't exist. <a href="/">Head back to the start</a>.</p>
  </PageHero>
</Base>

<style>
  .notice {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--c-muted);
  }
</style>
