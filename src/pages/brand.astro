---
import { readFileSync } from 'node:fs';
import { publicDir } from 'astro:config/server';
import tokens from '../brand/tokens.css?raw';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import Base from '../layouts/Base.astro';

// Read from the stylesheet the site itself uses, so this page can't fall out of step with it.
const hexes = (block: string) => Object.fromEntries([...block.matchAll(/--c-([\w-]+):\s*(#[0-9a-f]{6})/gi)].map((m) => [m[1], m[2]]));
const values = hexes(tokens);
const roles: [string, string][] = [
  ['bg', 'Background'],
  ['panel', 'Cards and panels'],
  ['line', 'Lines'],
  ['text', 'Text'],
  ['muted', 'Secondary text'],
  ['dim', 'Labels and meta'],
  ['blue', 'Accent and buttons'],
  ['blue-soft', 'Links'],
  ['blue-deep', 'Accent backgrounds'],
];
const colours = roles.map(([token, role]) => ({ token, role, hex: values[token] }));
if (colours.some((c) => !c.hex)) throw new Error('brand: a colour is missing from src/brand/tokens.css');

// Each preview's width and height come from the file itself, so a redrawn logo can't
// leave the page reserving the wrong space: an SVG's viewBox, a PNG's IHDR chunk.
function size(file: string): [number, number] {
  const data = readFileSync(new URL(`brand/${file}`, publicDir));
  if (file.endsWith('.png')) return [data.readUInt32BE(16), data.readUInt32BE(20)];
  const box = data.toString().match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
  if (!box) throw new Error(`brand: no viewBox in public/brand/${file}`);
  return [Number(box[1]), Number(box[2])];
}
const logos = [
  { file: 'logo.svg', label: 'Logo', type: 'SVG' },
  { file: 'mark.svg', label: 'Mark', type: 'SVG' },
  { file: 'avatar-1024.png', label: 'Avatar, 1024 px square', type: 'PNG' },
].map((l) => {
  const [width, height] = size(l.file);
  return { ...l, width, height };
});
---

<Base
  title="Brand · TachyonCMS"
  description="The TachyonCMS logo and mark to download, the colours and fonts, and how to write the name."
  path="/brand"
>
  <PageHero
    eyebrow="Brand"
    title="Logos, colours and the name"
    lede="Writing about TachyonCMS, or putting it on a slide? Everything you need is here, and all of it is free to use for that."
  />

  <div class="brand-page">
    <Prose split>
      <h2 id="logos">Logo and mark</h2>
      <ul class="logos">
        {
          logos.map((l) => (
            <li>
              <div class="tile">
                <img src={`/brand/${l.file}`} alt="" width={l.width} height={l.height} />
              </div>
              <a href={`/brand/${l.file}`} download>
                {l.label} <span>{l.type}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p>
        Give the logo room: at least the mark's height on every side. Don't recolour it or stretch it, and keep it on
        a dark background, because that's the only one it's drawn for. The <a href="/trademark">trademark page</a>{' '}
        covers where you can use it.
      </p>

      <h2 id="name">Writing the name</h2>
      <p>
        <strong>TachyonCMS</strong>: one word, capital T, capital CMS. Not "Tachyon CMS", "TachyonCms" or "Tachyon" on its
        own. In code and commands it's lower case, because that's what you type: <code>tachyon serve</code>,{' '}
        <code>ghcr.io/tachyon-cms/tachyoncms</code>.
      </p>

      <h2 id="colours">Colours</h2>
      <p>The site and docs are dark only, so there's one set: near-black, quiet greys and one electric blue.</p>
      <div class="colours">
        <table>
          <thead>
            <tr>
              <th scope="col">Use</th>
              <th scope="col">Colour</th>
            </tr>
          </thead>
          <tbody>
            {
              colours.map((c) => (
                <tr>
                  <th scope="row">{c.role}</th>
                  <td>
                    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                      <rect width="19" height="19" x="0.5" y="0.5" rx="5" fill={c.hex} stroke="currentColor" stroke-opacity="0.3" />
                    </svg>
                    <code>{c.hex}</code>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 id="fonts">Fonts</h2>
      <div class="fonts">
        <div>
          <p class="sample sans">Inter</p>
          <p>Headings and text. Free under the SIL Open Font License.</p>
        </div>
        <div>
          <p class="sample mono">Geist Mono</p>
          <p>Code, labels and numbers. Free under the SIL Open Font License.</p>
        </div>
      </div>
    </Prose>
  </div>
</Base>

<style>
  .brand-page {
    padding: 64px 0 clamp(3.5rem, 6vw, 4.5rem);
  }
  .brand-page :global(.prose > h2:first-child) {
    margin-top: 0;
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }
  .logos li {
    display: grid;
    gap: 10px;
  }
  .tile {
    display: grid;
    place-items: center;
    height: 8rem;
    padding: 1rem;
    border: 1px solid var(--c-line-2);
    border-radius: 12px;
    background: linear-gradient(var(--c-panel), var(--c-bg));
  }
  .tile img {
    max-width: 100%;
    height: 2.5rem;
    width: auto;
  }
  /* The avatar is a square with the mark inside, so it needs more room to read. */
  .tile img[src$='.png'] {
    height: 6rem;
  }
  .logos a {
    font-size: 15px;
  }
  .logos a span {
    margin-left: 4px;
    font: 400 12px var(--font-mono);
    color: var(--c-muted);
  }
  /* The table takes the prose's rules; a long hex can scroll on the narrowest phone. */
  .colours {
    overflow-x: auto;
  }
  .colours td {
    white-space: nowrap;
  }
  .colours td svg {
    vertical-align: middle;
    margin-right: 10px;
  }
  .fonts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 24px 0;
  }
  .fonts p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
  .fonts .sample {
    margin-bottom: 6px;
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--c-text);
  }
  @media (min-width: 40rem) {
    .fonts > div + div {
      padding-left: 32px;
      border-left: 1px solid var(--c-line);
    }
  }
  .sans {
    font-family: var(--font-sans);
  }
  .mono {
    font-family: var(--font-mono);
  }
</style>
