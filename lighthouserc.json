{
  "ci": {
    "collect": {
      "startServerCommand": "sh -c 'npx wrangler pages dev dist --port 8788 --ip 127.0.0.1 & npx wrangler dev -c docs/wrangler.jsonc --port 8789 --ip 127.0.0.1 & until curl -sf -o /dev/null http://127.0.0.1:8788/ && curl -sf -o /dev/null http://127.0.0.1:8789/; do sleep 1; done; echo servers ready; wait'",
      "startServerReadyPattern": "servers ready",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:8788/",
        "http://127.0.0.1:8788/product/access-control",
        "http://127.0.0.1:8788/blog",
        "http://127.0.0.1:8789/access-rules",
        "http://127.0.0.1:8789/reference/http-api"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "canonical"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
