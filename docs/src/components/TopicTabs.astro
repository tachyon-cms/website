---
// Starlight's header with the sidebar topics as a row of tabs under it.
import Default from '@astrojs/starlight/components/Header.astro';

const { topics } = Astro.locals.starlightSidebarTopics;
const here = `/${Astro.locals.starlightRoute.id}`;
---

<div class="topic-header">
  <div class="bar"><Default /></div>
  <div class="tabs print:hidden">
    <nav aria-label="Topics">
      <ul>
        {
          topics.map((topic) => (
            <li>
              <a
                href={topic.link}
                aria-current={topic.isCurrent ? (topic.link === here ? 'page' : 'true') : undefined}
              >
                {topic.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="site" href="https://tachyoncms.com">tachyoncms.com</a>
  </div>
</div>

<style>
  /* The fixed header grows by a tab row. Starlight sizes the sidebar, content offset
   * and scroll padding from --sl-nav-height, so they all move down with it. */
  :global(:root) {
    --tc-bar: 3.5rem;
    --tc-tabs: 2.75rem;
    --sl-nav-height: calc(var(--tc-bar) + var(--tc-tabs));
  }
  @media (min-width: 50em) {
    :global(:root) {
      --tc-bar: 4rem;
    }
  }

  /* Keep the logo and the mobile menu button sized and centred to the top bar. */
  :global(.site-title img) {
    height: calc(var(--tc-bar) - 2 * var(--sl-nav-pad-y));
  }
  :global(.sl-menu-button) {
    top: calc((var(--tc-bar) - var(--sl-menu-button-size)) / 2);
  }

  .topic-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .bar {
    height: calc(var(--tc-bar) - 2 * var(--sl-nav-pad-y));
  }

  /* Bleeds to the header's edges, past its padding, so the divider spans the page and
   * the underline sits on the header's bottom border. */
  .tabs {
    flex: none;
    height: var(--tc-tabs);
    margin-block-start: var(--sl-nav-pad-y);
    margin-inline: calc(-1 * var(--sl-nav-pad-x));
    padding-inline: var(--sl-nav-pad-x);
    border-top: 1px solid var(--sl-color-hairline-shade);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav {
    height: 100%;
  }
  @media (max-width: 49.99em) {
    /* On phones the header keeps room on the right for the menu button. */
    :global([data-has-sidebar]) .tabs {
      margin-inline-end: calc(-1 * (var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)));
    }
  }

  ul {
    display: flex;
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    height: 100%;
    /* Room for the inset focus ring. */
    padding-inline: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
    border-block: 2px solid transparent;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  .site {
    flex: none;
    font-weight: 400;
  }
  /* No room beside the tabs on a phone; the Overview page links the site instead. */
  @media (max-width: 29.99em) {
    .site {
      display: none;
    }
  }
  /* Inset, because .tabs scrolls sideways and would clip a ring drawn outside. */
  a:focus-visible {
    outline: 2px solid var(--c-violet);
    outline-offset: -2px;
  }
  a[aria-current] {
    color: var(--c-hi);
    border-block-end-color: var(--c-violet);
  }
</style>
