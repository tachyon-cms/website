---
// Replaces Starlight's provider, which follows the OS. Dark is the default here, as on
// the site, and a saved choice applies before first paint. scripts/csp.mjs hashes it.
// Starlight renders data-theme="dark" on <html> itself, so the site's no-JS rule can't
// tell whether this ran; data-theme-js marks that it did (see ThemeSelect.astro).
import { initTheme } from '../../../src/scripts/theme';

const themeScript = `document.documentElement.dataset.themeJs = '';(${initTheme.toString()})();`;
---

<script is:inline set:html={themeScript} />
