---
import Default from '@astrojs/starlight/components/Head.astro';
import { Font } from 'astro:assets';
---

<!-- html.js: scripts will run. mark-pending holds the header mark undrawn until its
     draw-in starts; if that script hasn't run in 1.5 s, the finished mark shows anyway.
     The same script as the site's Base.astro, hashed by scripts/csp.mjs. -->
<script is:inline>
  document.documentElement.classList.add('js', 'mark-pending');
  setTimeout(() => document.documentElement.classList.remove('mark-pending'), 1500);
</script>
<Default />
<!-- The weights the site preloads: body text, then headings, bold and the title. -->
<Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 600 }]} />
<Font cssVariable="--font-mono" preload={[{ weight: 400 }]} />
