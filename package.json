{
  "name": "tachyoncms-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site",
    "build:site": "astro check && astro build && node scripts/csp.mjs",
    "build:docs": "npm -w docs run build",
    "preview": "wrangler pages dev dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p functions/tsconfig.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "astro": "7.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "docs"
  ]
}
