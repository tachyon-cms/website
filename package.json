{
  "name": "tachyoncms-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site",
    "build:site": "astro check && astro build && cp src/styles/site.css dist/site.css && node scripts/csp.mjs dist headers.base --allow-script https://challenges.cloudflare.com --allow-frame https://challenges.cloudflare.com",
    "build:docs": "npm -w docs run build",
    "preview": "wrangler pages dev dist",
    "test": "vitest run --dir test && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p functions/tsconfig.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "astro": "7.4.2",
    "parse5": "8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "docs"
  ]
}
