{
  "name": "tachyoncms-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site",
    "build:site": "astro check && astro build && node scripts/csp.mjs dist headers.base --allow-script https://challenges.cloudflare.com --allow-frame https://challenges.cloudflare.com",
    "build:docs": "npm -w docs run build",
    "preview": "wrangler pages dev dist",
    "test": "vitest run --dir test && node --test scripts/*.test.mjs docs/scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p functions/tsconfig.json && tsc -p test/tsconfig.json",
    "brand": "node brand/build.mjs",
    "snapshot": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/snapshot.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.2",
    "fontkit": "2.0.4",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "svgo": "4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.155.0",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "docs"
  ],
  "overrides": {
    "@lhci/cli": {
      "lighthouse": "13.6.0",
      "uuid": "11.1.1"
    },
    "@lhci/utils": {
      "lighthouse": "13.6.0"
    },
    "basic-ftp": "6.2.3",
    "tmp": "0.2.7"
  }
}
